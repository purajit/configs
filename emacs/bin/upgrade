#!/usr/bin/env bash
set -euo pipefail

config_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lockfile="${config_dir}/versions.el"
emacs_bin="${EMACS:-$(command -v emacs)}"
backup="$(mktemp "${TMPDIR:-/tmp}/emacs-versions.XXXXXX")"
had_lock=0

cleanup() {
  rm -f "${backup}"
}
trap cleanup EXIT

if [[ -f "${lockfile}" ]]; then
  cp "${lockfile}" "${backup}"
  had_lock=1
fi

rollback() {
  printf 'Upgrade failed; restoring the previous package set...\n' >&2
  if [[ "${had_lock}" == 1 ]]; then
    cp "${backup}" "${lockfile}"
    "${emacs_bin}" -Q --batch -l "${config_dir}/bin/rollback.el"
  else
    rm -f "${lockfile}"
  fi
}

if ! "${emacs_bin}" --batch --init-directory "${config_dir}" \
     -l "${config_dir}/early-init.el" -l "${config_dir}/init.el" \
     --eval '(pm/upgrade-packages)'; then
  rollback
  exit 1
fi

if ! "${emacs_bin}" --batch --init-directory "${config_dir}" \
     -l "${config_dir}/early-init.el" -l "${config_dir}/init.el" \
     --eval '(pm/smoke-test)'; then
  rollback
  exit 1
fi

printf 'Packages upgraded and verified. Review and commit %s.\n' "${lockfile}"
